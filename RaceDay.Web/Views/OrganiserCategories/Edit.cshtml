@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
    var eventName = ViewData["EventName"] as string ?? "event";
}
<div class="rd-page-head">
    <a asp-action="Index" asp-route-eventId="@Model.EventId" class="rd-back"><i class="bi bi-arrow-left me-1"></i>Back to categories</a>
    <h1>Edit category</h1>
    <div class="rd-subtle">@eventName</div>
</div>

<div class="rd-panel" style="max-width: 640px">
    <form asp-action="Edit" asp-route-eventId="@Model.EventId" asp-route-id="@Model.CategoryId" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DistanceKm" class="form-label"></label>
            <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
            <span asp-validation-for="DistanceKm" class="text-danger"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-6">
                <label asp-for="MinAge" class="form-label"></label>
                <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" />
                <span asp-validation-for="MinAge" class="text-danger"></span>
            </div>
            <div class="col-6">
                <label asp-for="MaxAge" class="form-label"></label>
                <input asp-for="MaxAge" type="number" min="0" max="120" class="form-control" />
                <span asp-validation-for="MaxAge" class="text-danger"></span>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-6">
                <label asp-for="MaxParticipants" class="form-label"></label>
                <input asp-for="MaxParticipants" type="number" min="0" class="form-control" />
                <span asp-validation-for="MaxParticipants" class="text-danger"></span>
            </div>
            <div class="col-6">
                <label asp-for="EntryFee" class="form-label"></label>
                <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="EntryFee" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-rd-accent" data-once>Save changes</button>
            <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
