@model CategoriesPageViewModel
@{
    ViewData["Title"] = "Categories - " + Model.Event.EventName;
}
<partial name="_EventTabs" model='new EventTabsModel(Model.Event, "categories")' />

<div class="row g-4">
    <div class="col-lg-7">
        <div class="rd-panel">
            <h2 class="rd-section-title">Categories for this event</h2>
            @if (Model.Categories.Count == 0)
            {
                <div class="rd-empty py-4">
                    <i class="bi bi-tags"></i>
                    <p class="mb-0">No categories yet. Add one using the form so participants can enter.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table">
                        <thead><tr><th>Category</th><th>Defined by</th><th>Fee</th><th>Entries</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var c in Model.Categories)
                        {
                            <tr>
                                <td class="fw-bold">@c.CategoryName</td>
                                <td>
                                    @if (c.DistanceKm.HasValue) { <span class="rd-pill"><i class="bi bi-signpost-split me-1"></i>@Formatters.Km(c.DistanceKm.Value)</span> }
                                    @if (c.MinAge.HasValue || c.MaxAge.HasValue) { <span class="rd-pill"><i class="bi bi-people me-1"></i>@Formatters.AgeRange(c.MinAge, c.MaxAge)</span> }
                                </td>
                                <td class="text-nowrap">@Formatters.Money(c.EntryFee)</td>
                                <td class="text-nowrap">@c.CurrentEnrolmentCount / @(c.MaxParticipants == 0 ? "no limit" : c.MaxParticipants.ToString())</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-eventId="@Model.Event.EventId" asp-route-id="@c.CategoryId" class="btn btn-sm btn-rd-primary" title="Edit"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="Delete" asp-route-eventId="@Model.Event.EventId" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                                          data-confirm="Delete the &quot;@c.CategoryName&quot; category?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="rd-panel">
            <h2 class="rd-section-title">Add a category</h2>
            <form asp-action="Create" asp-route-eventId="@Model.Event.EventId" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
                <div class="mb-3">
                    <label asp-for="NewCategory.CategoryName" class="form-label"></label>
                    <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="e.g. 10km, Under 20, Senior" />
                    <span asp-validation-for="NewCategory.CategoryName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                    <input asp-for="NewCategory.DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                    <span asp-validation-for="NewCategory.DistanceKm" class="text-danger"></span>
                    <div class="form-text">Use a distance for distance categories, an age range for age categories, or both.</div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="NewCategory.MinAge" class="form-label"></label>
                        <input asp-for="NewCategory.MinAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="NewCategory.MinAge" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.MaxAge" class="form-label"></label>
                        <input asp-for="NewCategory.MaxAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="NewCategory.MaxAge" class="text-danger"></span>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label asp-for="NewCategory.MaxParticipants" class="form-label"></label>
                        <input asp-for="NewCategory.MaxParticipants" type="number" min="0" class="form-control" />
                        <span asp-validation-for="NewCategory.MaxParticipants" class="text-danger"></span>
                        <div class="form-text">0 means no limit.</div>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.EntryFee" class="form-label"></label>
                        <input asp-for="NewCategory.EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="NewCategory.EntryFee" class="text-danger"></span>
                        <div class="form-text">0 means free.</div>
                    </div>
                </div>
                <button type="submit" class="btn btn-rd-accent w-100" data-once><i class="bi bi-plus-circle-fill me-1"></i>Add category</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
