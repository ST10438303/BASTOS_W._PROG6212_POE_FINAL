@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My enrolments";
}
<div class="rd-page-head">
    <h1>My enrolments</h1>
    <div class="rd-subtle">Every event you've entered, and where your entry stands.</div>
</div>

@if (Model.Count == 0)
{
    <div class="rd-panel rd-empty">
        <i class="bi bi-clipboard-check"></i>
        <h2>You haven't entered any events yet</h2>
        <p class="mb-4">Browse upcoming events and pick a category to get started.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-rd-accent">Browse events</a>
    </div>
}
else
{
    <div class="rd-panel">
        <div class="mb-3 d-flex flex-wrap gap-3 align-items-center">
            <span class="rd-subtle fw-bold text-uppercase small">Status guide</span>
            <span><partial name="_StatusBadge" model='"Confirmed"' /> <span class="rd-subtle small">entry accepted</span></span>
            <span><partial name="_StatusBadge" model='"Pending"' /> <span class="rd-subtle small">waiting for the organiser</span></span>
            <span><partial name="_StatusBadge" model='"Cancelled"' /> <span class="rd-subtle small">entry withdrawn</span></span>
        </div>
        <div class="table-responsive">
            <table class="table rd-table">
                <thead>
                    <tr><th>Event</th><th>Category</th><th>Race no.</th><th>Enrolled on</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="fw-bold">@e.EventName</a></td>
                        <td>@e.CategoryName</td>
                        <td><code>@e.RaceNumber</code></td>
                        <td>@Formatters.Date(e.EnrolmentDate)</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            @if (e.Status != "Cancelled")
                            {
                                <form asp-action="Cancel" method="post" class="d-inline" data-confirm="Cancel your enrolment in @e.EventName (@e.CategoryName)?">
                                    <input type="hidden" name="id" value="@e.EnrolmentId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
