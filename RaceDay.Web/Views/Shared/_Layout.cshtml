@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Active(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : string.Empty;

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isOrganiser = User.IsInRole(RoleNames.Organiser);
    var isParticipant = User.IsInRole(RoleNames.Participant);

    var displayName = Context.Session.GetString(SessionKeys.FullName) ?? User.Identity?.Name ?? string.Empty;
    var pictureUrl = Context.Session.GetString(SessionKeys.ProfilePictureUrl);
    var initial = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim()[0].ToString().ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230A1F44'/%3E%3Cpath d='M14 44 L30 16 L36 28 L28 44 Z' fill='%23FF5C1A'/%3E%3Cpath d='M30 44 L46 16 L52 28 L44 44 Z' fill='%23C6F135'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                    <span class="rd-brand-mark"><i class="bi bi-lightning-charge-fill"></i></span>RACE<span class="rd-brand-accent">DAY</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (isOrganiser)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("OrganiserEvents", "OrganiserCategories", "OrganiserEnrolments", "OrganiserResults")" asp-controller="OrganiserEvents" asp-action="Index"><i class="bi bi-flag me-1"></i>Manage events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-1"></i>Profile</a></li>
                        }
                        else if (isParticipant)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home", "Events")" asp-controller="Home" asp-action="Index"><i class="bi bi-calendar-event me-1"></i>Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Enrolments")" asp-controller="Enrolments" asp-action="Index"><i class="bi bi-clipboard-check me-1"></i>My enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Results")" asp-controller="Results" asp-action="Index"><i class="bi bi-trophy me-1"></i>My results</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-1"></i>Profile</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home", "Events")" asp-controller="Home" asp-action="Index"><i class="bi bi-calendar-event me-1"></i>Events</a></li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (isAuthenticated)
                        {
                            <a class="rd-user" asp-controller="Profile" asp-action="Index" title="Your profile">
                                @if (!string.IsNullOrEmpty(pictureUrl))
                                {
                                    <img src="@pictureUrl" alt="" class="rd-avatar" />
                                }
                                else
                                {
                                    <span class="rd-avatar rd-avatar-initial">@initial</span>
                                }
                                <span class="rd-user-text">
                                    <span class="rd-user-name">@displayName</span>
                                    <span class="rd-user-role">@(isOrganiser ? "Organiser" : "Participant")</span>
                                </span>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right me-1"></i>Log out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-sm btn-rd-accent" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container rd-main">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span><strong>RACE<span class="rd-brand-accent">DAY</span></strong> &middot; South African running, walking &amp; cycling events</span>
            <span class="text-muted-light">&copy; @DateTime.UtcNow.Year RaceDay &middot; PROG6212 POE</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
