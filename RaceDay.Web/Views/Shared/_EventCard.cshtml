@model EventDto
@{
    var typeClass = "rd-type-" + Model.EventType.ToLowerInvariant();
}
<div class="card rd-event-card h-100">
    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="rd-event-media @typeClass">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <img src="@Model.BannerImageUrl" alt="@Model.EventName banner" loading="lazy" />
        }
        else
        {
            <span class="rd-event-fallback"><i class="bi @Formatters.TypeIcon(Model.EventType)"></i></span>
        }
        <span class="rd-type-badge @typeClass"><i class="bi @Formatters.TypeIcon(Model.EventType) me-1"></i>@Model.EventType</span>
    </a>
    <div class="card-body d-flex flex-column">
        <div class="rd-event-date"><i class="bi bi-calendar-event me-1"></i>@Formatters.Date(Model.EventDate)
            <span class="rd-relative">&middot; @Formatters.Relative(Model.EventDate)</span></div>
        <h3 class="rd-event-title"><a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">@Model.EventName</a></h3>
        <div class="rd-event-meta"><i class="bi bi-geo-alt-fill me-1"></i>@Model.Location</div>
        <div class="rd-event-meta"><i class="bi bi-signpost-split-fill me-1"></i>@Formatters.Km(Model.Distance)</div>
        <div class="mt-auto pt-3">
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-rd-primary btn-sm w-100">
                View event &amp; categories <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>
