@{
    var success = TempData["Success"] as string;
    var warning = TempData["Warning"] as string;
    var error = TempData["Error"] as string;
}
@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success alert-dismissible fade show rd-alert" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(warning))
{
    <div class="alert alert-warning alert-dismissible fade show rd-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@warning
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show rd-alert" role="alert">
        <i class="bi bi-x-octagon-fill me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
